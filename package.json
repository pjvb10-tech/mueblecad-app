{
  "name": "mueblecad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DiseÃ±o 3D de muebles en madera con lista de cortes, optimizaciÃ³n de planchas y agente MCP",
  "keywords": [
    "muebles",
    "carpinterÃ­a",
    "cad",
    "3d",
    "lista de cortes",
    "nesting",
    "mcp",
    "three.js",
    "electron"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "tsx server/server.ts",
    "mcp": "tsx server/mcp.ts",
    "test": "tsx --test src/core/*.test.ts src/web/*.test.ts server/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:web": "vite build",
    "app": "vite build && electron .",
    "dist": "vite build && node build/build-mcp.cjs && electron-builder --win portable nsis --publish never",
    "dist:mac": "vite build && node build/build-mcp.cjs && electron-builder --mac --arm64 --publish never",
    "icon": "electron build/make-icon.cjs",
    "build:mcp": "node build/build-mcp.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "dxf-parser": "^1.1.2",
    "three": "^0.170.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.170.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "main": "electron/main.cjs",
  "author": "Contribuidores de MuebleCAD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pjvb10-tech/mueblecad-app.git"
  },
  "homepage": "https://github.com/pjvb10-tech/mueblecad-app",
  "build": {
    "appId": "local.mueblecad",
    "productName": "MuebleCAD",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "dist-mcp/mcp.cjs",
      "server/*.cjs",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "MuebleCAD.exe"
    },
    "fileAssociations": [
      {
        "ext": "mcad",
        "name": "Proyecto MuebleCAD",
        "description": "Proyecto MuebleCAD",
        "role": "Editor"
      }
    ],
    "afterPack": "build/afterPack.cjs",
    "icon": "build/icon.png",
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "artifactName": "MuebleCAD-${version}-mac-${arch}.${ext}",
      "darkModeSupport": false
    },
    "dmg": {
      "title": "MuebleCAD"
    },
    "nsis": {
      "artifactName": "MuebleCAD-Setup.exe",
      "oneClick": true,
      "perMachine": false
    }
  },
  "engines": {
    "node": ">=20"
  }
}
